{
    "compilerOptions": {
        "module": "commonjs",
        "target": "ES2022",
        "outDir": "dist",
        "rootDir": "src",
        "jsx": "react",
        "noUnusedLocals": true,
        "declaration": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noEmitHelpers": true,
        "importHelpers": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "lib": ["ES2022", "dom"],
        "newLine": "LF"
    },
    "exclude": ["**/__tests__", "dist"]
}
